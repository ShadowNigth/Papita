func t(key: String, args: Array = []) -> String:
	var locale := "es"
	if Settings and Settings.data.has("gameplay"):
		locale = String(Settings.data.gameplay.get("language", "es"))
	var table: Dictionary = STRINGS.get(locale, STRINGS.es)
	var text: String = table.get(key, STRINGS.es.get(key, key))
	if not args.is_empty():
		text = text % args
	return text


func set_language(code: String) -> void:
	Settings.set_value("gameplay", "language", code)
	TranslationServer.set_locale(code)
